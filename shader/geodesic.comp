#version 430
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba32f, binding = 0) uniform writeonly image2D outImage;
layout(std140, binding = 1) uniform Camera{
    vec3 camPos;     float _pad0;
    vec3 camRight;   float _pad1;
    vec3 camUp;      float _pad2;
    vec3 camForward; float _pad3;
    float tanHalfFov;
    float aspect;
    bool moving;
    int   _pad4;
} cam;

layout(std140, binding = 2) uniform Disk{
    float r1;
    float r2;
    float num;
    float thickness;
} disk;

layout(std140, binding = 3) uniform Objects {
    int numObjects; float objPad0, objPad1, objPad2;
    vec4 objPosRadius[16];
    vec4 objColor[16];
    float  mass[16]; 
} objs;

uniform samplerCube skybox;

const float rs = 1.269e10;
const float D_LAMBDA = 1e7;
const double ESCAPE_R = 1e30;
const float CAPTURE_R = rs * 1.5;
const float Tscale = 8000.0;

struct Ray{
    float x, y, z; // Cartesian coordinate
    float r, theta, phi; // Spherical coordinate
    float dr, dtheta, dphi;
    float E, L; // Energy E and angular momentum L 
};

Ray initRay(vec3 pos, vec3 dir){
    Ray ray;

    // 1. Convert cartesian position to spherical coordinate
    ray.x = pos.x;
    ray.y = pos.y;
    ray.z = pos.z;
    ray.r = length(pos);
    ray.theta = acos(pos.z / ray.r);
    ray.phi = atan(pos.y, pos.x);

    // 2. Convert cartesian direction to spherical coordinate
    float dx = dir.x;
    float dy = dir.y;
    float dz = dir.z;

    ray.dr = sin(ray.theta)*cos(ray.phi)*dx + sin(ray.theta)*sin(ray.phi)*dy + cos(ray.theta)*dz;
    ray.dtheta = (cos(ray.theta)*cos(ray.phi)*dx + cos(ray.theta)*sin(ray.phi)*dy - sin(ray.theta)*dz) / ray.r;
    ray.dphi = (-sin(ray.phi)*dx + cos(ray.phi)*dy) / (ray.r * sin(ray.theta));

    // 3. Calculate L and E
    ray.L = ray.r * ray.r * sin(ray.theta) * ray.dphi;
    float f = 1.0 - rs / ray.r;
    float dt_dL = sqrt((ray.dr*ray.dr)/f + ray.r*ray.r*(ray.dtheta*ray.dtheta + sin(ray.theta)*sin(ray.theta)*ray.dphi*ray.dphi));
    ray.E = f * dt_dL;

    return ray;
}

bool intercept(Ray ray, float rs) {
    return ray.r <= rs;
}


void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r = ray.r, theta = ray.theta;
    float dr = ray.dr, dtheta = ray.dtheta, dphi = ray.dphi;
    float f = 1.0 - rs / r;
    float dt_dL = ray.E / f;

    d1 = vec3(dr, dtheta, dphi);
    d2.x = - (rs / (2.0 * r*r)) * f * dt_dL * dt_dL
         + (rs / (2.0 * r*r * f)) * dr * dr
         + r * (dtheta*dtheta + sin(theta)*sin(theta)*dphi*dphi);
    d2.y = -2.0*dr*dtheta/r + sin(theta)*cos(theta)*dphi*dphi;
    d2.z = -2.0*dr*dphi/r - 2.0*cos(theta)/(sin(theta)) * dtheta * dphi;
}

void rk4Step(inout Ray ray, float dL) {
    vec3 k1a, k1b;
    geodesicRHS(ray, k1a, k1b);

    Ray r2 = ray;
    r2.r      += 0.5 * dL * k1a.x;
    r2.theta  += 0.5 * dL * k1a.y;
    r2.phi    += 0.5 * dL * k1a.z;
    r2.dr     += 0.5 * dL * k1b.x;
    r2.dtheta += 0.5 * dL * k1b.y;
    r2.dphi   += 0.5 * dL * k1b.z;

    vec3 k2a, k2b;
    geodesicRHS(r2, k2a, k2b);

    Ray r3 = ray;
    r3.r      += 0.5 * dL * k2a.x;
    r3.theta  += 0.5 * dL * k2a.y;
    r3.phi    += 0.5 * dL * k2a.z;
    r3.dr     += 0.5 * dL * k2b.x;
    r3.dtheta += 0.5 * dL * k2b.y;
    r3.dphi   += 0.5 * dL * k2b.z;

    vec3 k3a, k3b;
    geodesicRHS(r3, k3a, k3b);

    Ray r4 = ray;
    r4.r      += dL * k3a.x;
    r4.theta  += dL * k3a.y;
    r4.phi    += dL * k3a.z;
    r4.dr     += dL * k3b.x;
    r4.dtheta += dL * k3b.y;
    r4.dphi   += dL * k3b.z;

    vec3 k4a, k4b;
    geodesicRHS(r4, k4a, k4b);

    ray.r      += dL * (k1a.x + 2.0 * k2a.x + 2.0 * k3a.x + k4a.x) / 6.0;
    ray.theta  += dL * (k1a.y + 2.0 * k2a.y + 2.0 * k3a.y + k4a.y) / 6.0;
    ray.phi    += dL * (k1a.z + 2.0 * k2a.z + 2.0 * k3a.z + k4a.z) / 6.0;
    ray.dr     += dL * (k1b.x + 2.0 * k2b.x + 2.0 * k3b.x + k4b.x) / 6.0;
    ray.dtheta += dL * (k1b.y + 2.0 * k2b.y + 2.0 * k3b.y + k4b.y) / 6.0;
    ray.dphi   += dL * (k1b.z + 2.0 * k2b.z + 2.0 * k3b.z + k4b.z) / 6.0;

    ray.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.y = ray.r * sin(ray.theta) * sin(ray.phi);
    ray.z = ray.r * cos(ray.theta);
}

bool intersectsDiskSlab(vec3 p0, vec3 p1, float halfH, out float segLen, out float rcyl) {
    float y0 = p0.y;
    float y1 = p1.y;
    float dy = y1 - y0;
    float tEnter = 0.0;
    float tExit = 1.0;

    if (abs(dy) < 1e-8) {
        if (abs(y0) > halfH) return false;
    } else {
        float t0 = (-halfH - y0) / dy;
        float t1 = ( halfH - y0) / dy;
        tEnter = min(t0, t1);
        tExit  = max(t0, t1);
        tEnter = clamp(tEnter, 0.0, 1.0);
        tExit  = clamp(tExit, 0.0, 1.0);
        if (tExit <= tEnter) return false;
    }

    vec3 mid = mix(p0, p1, 0.5 * (tEnter + tExit));
    rcyl = length(vec2(mid.x, mid.z));
    if (rcyl < disk.r1 || rcyl > disk.r2) return false;

    float edgeIn = smoothstep(disk.r1, disk.r1 * 1.02, rcyl);
    float edgeOut = 1.0 - smoothstep(disk.r2 * 0.98, disk.r2, rcyl);
    if (edgeIn * edgeOut <= 0.0) return false;

    float segment = length(p1 - p0);
    segLen = (tExit - tEnter) * segment;
    return segLen > 0.0;
}


float diskTemperature(float rcyl, float rin, float Tscale)
{
    float x = max(rcyl / rin, 1.0001);
    float T_full = pow(x, -0.75) * pow(max(1.0 - inversesqrt(x), 0.0), 0.25);
    float T_pow  = pow(x, -0.75);
    float mixK = 0.7; // 0=纯full(你现在), 1=纯幂律(更有梯度). 先试0.6~0.9
    float shape = mix(T_full, T_pow, mixK);
    return Tscale * shape;
}


// sRGB -> Linear (accurate piecewise, better than pow(x,2.2))
vec3 srgbToLinear(vec3 c)
{
    bvec3 cut = lessThanEqual(c, vec3(0.04045));
    vec3 lower = c / 12.92;
    vec3 upper = pow((c + 0.055) / 1.055, vec3(2.4));
    return vec3(cut.x ? lower.x : upper.x,
                cut.y ? lower.y : upper.y,
                cut.z ? lower.z : upper.z);
}

// Kelvin -> RGB (returns LINEAR rgb, suitable for HDR lighting math)
vec3 temperatureToRGB(float kelvin)
{
    // This approximation behaves best in roughly [1000K, 40000K]
    kelvin = clamp(kelvin, 1000.0, 40000.0);

    float t = kelvin / 100.0;
    float r, g, b;

    // guard log domain
    float tSafe = max(t, 1e-4);

    if (tSafe <= 66.0) {
        r = 1.0;
        g = clamp(0.3900816 * log(tSafe) - 0.6318414, 0.0, 1.0);
    } else {
        float x = max(tSafe - 60.0, 1e-4);
        r = clamp(1.2929362 * pow(x, -0.1332048), 0.0, 1.0);
        g = clamp(1.1298909 * pow(x, -0.0755148), 0.0, 1.0);
    }

    if (tSafe >= 66.0) {
        b = 1.0;
    } else if (tSafe <= 19.0) {
        b = 0.0;
    } else {
        float y = max(tSafe - 10.0, 1e-4);
        b = clamp(0.5432068 * log(y) - 1.1962541, 0.0, 1.0);
    }

    // This fit outputs a display-like RGB (≈ sRGB). Convert to linear for HDR math.
    vec3 srgb = vec3(r, g, b);
    return srgbToLinear(srgb);
}

vec3 acesToneMap(vec3 x){
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x*(a*x+b))/(x*(c*x+d)+e), 0.0, 1.0);
}


void main() {
    // Pixel coordinate corresponding to current work item
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy); 

    // Size of output image (pixels)
    ivec2 sz = imageSize(outImage);
    
    int WIDTH = sz.x;
    int HEIGHT = sz.y;

    // Compute Ray direction
    if (pix.x >= sz.x || pix.y >= sz.y) return; // Avoid overflow
    float u = (2 * (pix.x + 0.5) / WIDTH - 1) * // normalize and map pixel coordinate to [-1, 1] (ndc)
                cam.aspect * cam.tanHalfFov;
    float v = (1 - 2 * (pix.y + 0.5) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(cam.camForward + v * cam.camUp + u * cam.camRight);
    Ray ray = initRay(cam.camPos, dir);

    // Cubemap Sampler
    vec3 dirToSample; // Light escape direction
    vec3 bg;

    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);
    vec3 diskAccum = vec3(0.0);
    float accumAlpha = 0.0;
    float lambda = 0.0;

    // Check hit event
    bool hitBlackHole = false;
    bool hitObject = false;

    int steps = 20000;

    for (int i = 0; i < steps; ++i) {
        if (intercept(ray, rs)){
            hitBlackHole = true;
            break;
        }
        rk4Step(ray, D_LAMBDA);
        lambda += D_LAMBDA;

        vec3 newPos = vec3(ray.x, ray.y, ray.z);
        float segLen = 0.0;
        float rcyl = 0.0;
        float halfH = disk.thickness * 0.5;
        if (intersectsDiskSlab(prevPos, newPos, halfH, segLen, rcyl)){
            // 1. temperature profile (thin disk)
            float rin = disk.r1;
            float T = diskTemperature(rcyl, rin, Tscale);

            // 3. relativistic g-factor
            float g = 1.0;
            {
                float M = 0.5 * rs;
                float ut = inversesqrt(max(1.0 - 3.0 * M / rcyl, 1e-6));
                float Omega = sqrt(M / (rcyl*rcyl*rcyl));
                float uphi = Omega * ut;

                float b = ray.L / max(ray.E, 1e-8);
                g = 1.0 / max(ut - uphi * b, 1e-6);
            }

            // 4. Doppler beaming (approx) + observed temperature -> color (linear RGB)
            vec3 midPos = (prevPos + newPos) * 0.5;
            vec3 tangential = normalize(vec3(-midPos.z, 0.0, midPos.x));
            vec3 kDir = normalize(prevPos - newPos); // direction toward camera
            float M = 0.5 * rs;
            float v = sqrt(M / max(rcyl, 1e-6));
            float beta = clamp(v, 0.0, 0.5);
            float gamma = inversesqrt(1.0 - beta * beta);
            float cosang = clamp(dot(tangential, kDir), -1.0, 1.0);
            float D = 1.0 / max(gamma * (1.0 - beta * cosang), 1e-6);
            D = clamp(D, 0.6, 1.8);
            float gTotal = g * mix(1.0, D, 0.6);
            float Tobs = clamp(gTotal * T, 1000.0, 40000.0);
            vec3 chroma = temperatureToRGB(Tobs); // linear

            // 5. brightness (HDR) with tighter inner edge and stronger radial falloff
            float rSpan = max(disk.r2 - disk.r1, 1e-6);
            float rN = clamp((rcyl - disk.r1) / rSpan, 0.0, 1.0);
            float edgeIn = smoothstep(disk.r1, disk.r1 * 1.02, rcyl);
            float edgeOut = 1.0 - smoothstep(disk.r2 * 0.96, disk.r2, rcyl);
            float edge = edgeIn * edgeOut;
            float radial = pow(max(rcyl / disk.r1, 1.0), -2.6);
            float innerBand = exp(-pow(rN / 0.18, 2.0));
            float emissivity = edge * radial * (0.35 + 1.5 * innerBand) * pow(1.0 - rN, 1.0);
            float intensity = pow(T / Tscale, 4.0) * pow(g, 3.0) * pow(D, 2.0) * emissivity;
            vec3 diskColor = chroma * intensity;
            float h = clamp(abs(midPos.y) / max(halfH, 1.0), 0.0, 1.0);
            float density = 1.0 - h * h;
            float k = 4e-10; // absorption per meter (tuned for thinner disks)
            float alpha = 1.0 - exp(-k * segLen * density);
            diskAccum += (1.0 - accumAlpha) * diskColor * alpha;
            accumAlpha += (1.0 - accumAlpha) * alpha;
            if (accumAlpha >= 0.95) {
                break;
            }
        }
        if (ray.r <= CAPTURE_R) {
            if (accumAlpha <= 0.0) {
                hitBlackHole = true;
            }
            break;
        }
        prevPos = newPos;
        if (ray.r > ESCAPE_R) break;
    }

    dirToSample = normalize(vec3(ray.x, ray.y, ray.z));
    bg = texture(skybox, dirToSample).rgb;

    // Final color setting
    vec3 finalColor = vec3(0.0);
    if (hitBlackHole) {
        finalColor = vec3(0.0);
    } else if (accumAlpha > 0.0) {
        vec3 diskCol = diskAccum / max(accumAlpha, 1e-6);
        float exposure = 8.0;           // 先试 4~20
        diskCol *= exposure;
        finalColor = diskCol;
    } else {
        finalColor = bg;
    }

    finalColor = acesToneMap(finalColor);
    imageStore(outImage, pix, vec4(finalColor, 1.0));

}
